# Indicator Engine -- Environment Variables
# Copy this to .env (do NOT commit .env to git!)

# Web Dashboard (Optional - default port 8080 or Botkeep's SERVER_PORT)
HOST=0.0.0.0
PORT=8080
# Botkeep automatically provides SERVER_PORT; the engine will detect it automatically.

# Telegram Bot (OPTIONAL: Leave blank or omit to run in Web UI / Console mode)
TG_BOT_TOKEN=
TG_CHAT_ID=

# TwelveData API key (Free tier at twelvedata.com -- 800 req/day for XAU & OIL)
TWELVE_API_KEY=your_twelvedata_key_here

