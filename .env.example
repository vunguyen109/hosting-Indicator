# Indicator Engine -- Environment Variables
# Copy this to /opt/indicator/.env on the server and fill in real values.
# NEVER commit .env to git!

# Telegram Bot (get from @BotFather on Telegram)
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHAT_ID=-100123456789

# TwelveData API key (free tier at twelvedata.com -- 800 req/day)
TWELVE_API_KEY=your_twelvedata_key_here
