# Indicator Engine -- Cron jobs for disk hygiene
# Install with:  crontab -e  (as root or the indicator user)

# Delete rotated log files older than 7 days (safety net)
0 3 * * 0 find /opt/indicator/logs -name '*.log.*' -mtime +7 -delete

# Delete stale temp files left by atomic state writes (if any crash mid-write)
30 3 * * * find /opt/indicator/data -name '*.tmp' -mtime +1 -delete

# Weekly disk usage report to syslog (visible via journalctl -t indicator-disk)
0 9 * * 1 df -h / | logger -t indicator-disk

# Health check: restart service if it stopped (belt AND suspenders)
# systemd Restart=on-failure already handles this, but this catches edge cases
*/5 * * * * systemctl is-active --quiet indicator-engine || systemctl restart indicator-engine
