[Unit]
Description=Hosting Indicator Engine - Low Resource Quant Signal Service
Documentation=https://github.com/your-org/hosting-indicator
After=network-online.target
Wants=network-online.target

[Service]
# ---- Identity ---------------------------------------------------------------
Type=simple
User=indicator
Group=indicator
WorkingDirectory=/opt/indicator

# ---- Runtime ----------------------------------------------------------------
ExecStart=/opt/indicator/venv/bin/python /opt/indicator/engine.py
Restart=on-failure
RestartSec=10s
# Cap retries: if fails 5 times in 2 minutes, mark failed and stop retrying
StartLimitIntervalSec=120
StartLimitBurst=5

# ---- Environment (never commit actual tokens to git) -----------------------
EnvironmentFile=/opt/indicator/.env

# ---- CRITICAL: Hard memory ceiling -----------------------------------------
# Kernel will OOM-kill the process if it exceeds 256 MB.
# systemd will then auto-restart it via the Restart= directive above.
MemoryMax=256M
# Soft warning at 200 MB (logged to journal, no kill)
MemoryHigh=200M

# ---- CPU limits (prevent monopolizing the vCore) ---------------------------
# Restrict to 30% of one CPU core
CPUQuota=30%

# ---- File descriptor & process limits --------------------------------------
LimitNOFILE=4096
TasksMax=64

# ---- Logging (goes to systemd journal; journalctl -u indicator-engine) -----
StandardOutput=journal
StandardError=journal
SyslogIdentifier=indicator-engine

# ---- Security hardening (defense-in-depth) ---------------------------------
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/indicator/data /opt/indicator/logs
ProtectHome=true

[Install]
WantedBy=multi-user.target
